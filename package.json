{
  "name": "ces-clinical-education-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AMR Clinical Education Suite (CES) - QA Review Queue & Kansas CE Deadline Tracker PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "check:evidence": "node scripts/check-evidence-hash.mjs",
    "check:templates": "node scripts/check-templates.mjs",
    "check": "npm run check:evidence && npm run check:templates && npm run check:plan && npm run check:skills && npm run check:review && npm run check:pcr && npm run check:neop && npm run check:sim && npm run check:checkoff && npm run check:nav && npm run check:interview && npm run check:record && npm run check:clearance && npm run check:phi && npm run check:stage1 && npm run check:placement && npm run check:cqmp && npm run check:kpiimport && npm run check:documents && npm run check:records",
    "check:strict": "CES_CHECK_STRICT=1 npm run check",
    "check:plan": "node scripts/check-course-plan.mjs",
    "check:documents": "node scripts/check-documents.mjs",
    "check:records": "node scripts/check-records.mjs",
    "doc:application": "node scripts/build-application.mjs",
    "check:review": "node scripts/check-chart-review.mjs",
    "check:pcr": "node scripts/check-pcr-import.mjs",
    "check:neop": "node scripts/check-neop-exam.mjs",
    "check:sim": "node scripts/check-simulator.mjs",
    "check:checkoff": "node scripts/check-checkoff.mjs",
    "check:nav": "node scripts/check-nav.mjs",
    "check:interview": "node scripts/check-interview.mjs",
    "gen:neop": "node scripts/gen-neop-exam.mjs",
    "check:record": "node scripts/check-selection-record.mjs",
    "check:clearance": "node scripts/check-clearance.mjs",
    "check:phi": "node scripts/check-phi.mjs",
    "check:stage1": "node scripts/check-stage1.mjs",
    "check:placement": "node scripts/check-placement.mjs",
    "check:cqmp": "node scripts/check-cqmp.mjs",
    "check:kpiimport": "node scripts/check-kpi-import.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "doc:student": "node scripts/build-student-guide.mjs",
    "doc:syllabus": "node scripts/build-syllabus.mjs",
    "doc:curriculum": "node scripts/build-curriculum.mjs",
    "doc:objectives": "node scripts/build-objectives.mjs",
    "doc:policies": "node scripts/build-forms.mjs policies",
    "doc:forms": "node scripts/build-forms.mjs forms",
    "doc:all": "npm run doc:application && npm run doc:syllabus && npm run doc:curriculum && npm run doc:objectives && npm run doc:policies && npm run doc:forms && npm run doc:student",
    "check:reach": "node scripts/check-reach.mjs",
    "check:all": "npm run check && npm run build && npm run check:reach"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.2.108",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "docx": "^9.7.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  }
}
